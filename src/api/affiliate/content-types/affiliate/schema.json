{
  "kind": "collectionType",
  "collectionName": "affiliates",
  "info": {
    "singularName": "affiliate",
    "pluralName": "affiliates",
    "displayName": "Afiliado"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "sector": { "type": "relation", "relation": "manyToOne", "target": "api::sub-chamber.sub-chamber", "required": true },
    "city": { "type": "string" },
    "description": { "type": "text" },
    "logo": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["images"] },
    "website": { "type": "string" },
    "email": { "type": "email" },
    "phone": { "type": "string" },
    "featured": { "type": "boolean" },
    "order": { "type": "integer" },
    "seo": { "type": "component", "repeatable": false, "component": "shared.seo" }
  }
}
