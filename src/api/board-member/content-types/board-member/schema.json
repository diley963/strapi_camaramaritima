{
  "kind": "collectionType",
  "collectionName": "board_members",
  "info": {
    "singularName": "board-member",
    "pluralName": "board-members",
    "displayName": "Junta Directiva"
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "role": { "type": "string", "required": true },
    "organization": { "type": "string" },
    "sector": { "type": "relation", "relation": "manyToOne", "target": "api::sub-chamber.sub-chamber" },
    "image": { "type": "media", "multiple": false, "required": true, "allowedTypes": ["images"] },
    "linkedinUrl": { "type": "string" },
    "email": { "type": "email" },
    "phone": { "type": "string" },
    "order": { "type": "integer" },
    "active": { "type": "boolean", "default": true }
  }
}
