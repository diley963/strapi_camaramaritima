{
  "collectionName": "components_shared_links",
  "info": {
    "displayName": "link",
    "icon": "link",
    "description": "Enlace reutilizable para botones, menus y llamados a la accion"
  },
  "options": {},
  "attributes": {
    "label": {
      "type": "string",
      "required": true
    },
    "url": {
      "type": "string",
      "required": true
    },
    "target": {
      "type": "enumeration",
      "enum": [
        "_self",
        "_blank"
      ],
      "default": "_self"
    },
    "style": {
      "type": "enumeration",
      "enum": [
        "primary",
        "secondary",
        "outline",
        "text"
      ],
      "default": "primary"
    }
  }
}
